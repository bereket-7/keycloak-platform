# Application environment template
#
# Copy into your application repository (never commit real secrets):
#   cp config/apps/env.application.example .env.local
#
# Values below match the local Keycloak platform demo clients.

# Public — must match access token "iss"
KEYCLOAK_ISSUER=http://localhost:8080/realms/platform

# Public for SPA / mobile public clients
KEYCLOAK_CLIENT_ID=demo-web

# Secret — confidential clients / BFF only (demo-api). Leave empty for public SPAs.
KEYCLOAK_CLIENT_SECRET=

# Optional — set when the API validates audience
KEYCLOAK_AUDIENCE=

# Baseline OIDC scopes (add groups when consuming membership signals)
KEYCLOAK_SCOPES=openid profile email

# Optional helpers
KEYCLOAK_REDIRECT_URI=http://localhost:3000/callback
KEYCLOAK_POST_LOGOUT_REDIRECT_URI=http://localhost:3000/
KEYCLOAK_WEB_ORIGIN=http://localhost:3000
