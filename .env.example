# Keycloak Platform — local environment variables
#
# Copy this file to .env and replace placeholder values:
#   cp .env.example .env
#
# Never commit .env. Real secrets belong only on your machine or in a
# secret manager (staging/production).

# -----------------------------------------------------------------------------
# PostgreSQL (Keycloak database)
# -----------------------------------------------------------------------------

POSTGRES_DB=keycloak
POSTGRES_USER=keycloak
POSTGRES_PASSWORD=changeme

# -----------------------------------------------------------------------------
# Keycloak admin (initial bootstrap user for the admin console)
# -----------------------------------------------------------------------------

KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=changeme

# -----------------------------------------------------------------------------
# Keycloak database connection
# Used by Keycloak to connect to PostgreSQL over the Docker network.
# -----------------------------------------------------------------------------

KC_DB=postgres
KC_DB_URL=jdbc:postgresql://postgres:5432/keycloak
# KC_DB_USERNAME and KC_DB_PASSWORD are mapped from POSTGRES_USER/PASSWORD in docker-compose.yml

# -----------------------------------------------------------------------------
# Local HTTP port (Phase 01+)
# -----------------------------------------------------------------------------

KEYCLOAK_HTTP_PORT=8080
