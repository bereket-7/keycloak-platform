# Example nginx reverse proxy for Keycloak (production-shaped)
#
# Copy/adapt to your host. Do NOT commit real certificates or private keys.
# Replace auth.example.com and certificate paths.

upstream keycloak_upstream {
    server keycloak:8080;
    keepalive 32;
}

server {
    listen 80;
    server_name auth.example.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name auth.example.com;

    ssl_certificate     /etc/certs/fullchain.pem;
    ssl_certificate_key /etc/certs/privkey.pem;
    ssl_session_timeout 1d;
    ssl_session_cache shared:SSL:10m;

    # Reasonable limits for auth traffic
    client_max_body_size 1m;
    # rate limiting can be added via limit_req_zone in http {} context

    location / {
        proxy_pass http://keycloak_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header Connection "";
        proxy_buffer_size 128k;
        proxy_buffers 4 256k;
        proxy_busy_buffers_size 256k;
    }
}
